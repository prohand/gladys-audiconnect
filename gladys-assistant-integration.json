  "scene_actions": [
    {
      "key": "start_climatisation",
      "label": {
        "en": "Start the climate of a car",
        "fr": "Lancer la climatisation d'une voiture",
        "de": "Klimatisierung eines Fahrzeugs starten",
        "es": "Iniciar la climatización de un coche"
      },
      "description": {
        "en": "Heat or cool the car before leaving. Without a temperature, the car uses its own settings.",
        "fr": "Chauffe ou refroidit la voiture avant de partir. Sans température, la voiture garde ses réglages.",
        "de": "Heizt oder kühlt das Fahrzeug vor der Abfahrt. Ohne Temperatur nutzt es seine eigenen Einstellungen.",
        "es": "Calienta o enfría el coche antes de salir. Sin temperatura, el coche usa sus propios ajustes."
      },
      "timeout_seconds": 120,
